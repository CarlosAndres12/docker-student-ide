# =============================================================================
# docker-student-ide — Configuración
# =============================================================================
# Este archivo viene listo para usar. Editarlo es OPCIONAL (solo para
# personalizar). Los valores por defecto funcionan para la mayoría de los
# estudiantes.
#
# start.sh detecta automáticamente tu UID/GID al ejecutarlo. Si usas
# docker compose up directamente, se usan PUID=1000 y PGID=1000.
# =============================================================================

# ── User / Group IDs ─────────────────────────────────────────────────────────
# start.sh detecta automáticamente estos valores al ejecutarlo.
# Si editas a mano, usa los números que obtienes con:
#   id -u   (tu UID)
#   id -g   (tu GID)
PUID=1000
PGID=1000

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=Etc/UTC

# ── code-server Password ─────────────────────────────────────────────────────
# ¡Cambia esta contraseña si compartes la computadora!
# La contraseña por defecto es "student". Si cambias este valor, recuerda
# usar la nueva contraseña al iniciar sesión en code-server.
PASSWORD=student
# HASHED_PASSWORD=

# ── Host Port Mappings (overridable) ─────────────────────────────────────────
# Estos puertos se mapean del contenedor a tu computadora.
# Cámbialos si el puerto por defecto ya está en uso.
CODESERVER_PORT=8443    # code-server (el IDE)
JUPYTER_PORT=8888       # Jupyter / JupyterLab
MLFLOW_PORT=5555        # MLflow UI

# ── Device Toggle ────────────────────────────────────────────────────────────
# Cambia a "gpu" para activar NVIDIA GPU (requiere NVIDIA Container Toolkit).
DEVICE=cpu

# ── Frontend API Configuration (student-side, NOT baked into image) ──────────
# URL base del API que usa tu frontend.
# Los proyectos con Vite leen esto en tiempo de build/dev vía import.meta.env.
VITE_API_BASE_URL=https://astryx.atmeta.com/

# ── Pi AI Assistant — Free-Tier Routing ──────────────────────────────────────
# PI_FREE_ONLY=1 bloquea Pi a solo proveedores gratuitos.
# Ver la guía para comandos pi-free free/all.
PI_FREE_ONLY=1

# ── Pi Provider API Keys (optional, commented out by default) ────────────────
# Algunos proveedores gratuitos de Pi aceptan autenticación por clave API.
# Descomenta y completa las que tengas.
# KILO_API_KEY=
# CLINE_API_KEY=
# OPENROUTER_API_KEY=

# ── Additional Free Model Providers (optional) ────────────────────────────────
# Proveedores gratuitos adicionales compatibles con los agentes del entorno.
# Descomenta y completa las claves que tengas.
# SAMBANOVA_API_KEY=
# LLM7_API_KEY=
# OPENMODEL_API_KEY=
