# =============================================================================
# docker-student-ide — Environment Configuration REFERENCE
# =============================================================================
# THIS IS A REFERENCE TEMPLATE — do NOT copy or edit this file.
# The project ships with a ready-to-run .env file.  Edit that one if you
# need to override any values.
#
# This file documents every configurable variable with comments.
# Use it as a reference when customizing your .env.
# =============================================================================

# ── User / Group IDs ─────────────────────────────────────────────────────────
# These MUST match your host user's IDs so files created inside the container
# are owned by you, not root.  Run these commands in your terminal:
#   id -u   (prints your UID)
#   id -g   (prints your GID)
PUID=1000
PGID=1000

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=Etc/UTC

# ── code-server Password ─────────────────────────────────────────────────────
# REQUIRED: Set a password for the browser-based IDE.
# Either PASSWORD (plaintext) or HASHED_PASSWORD (bcrypt hash, optional).
# NEVER hardcode this in the Dockerfile or commit it to version control.
PASSWORD=changeme
# HASHED_PASSWORD=

# ── Host Port Mappings (overridable) ─────────────────────────────────────────
# These ports are mapped from the container to your host machine.
# Change them if the default port is already in use on your system.
CODESERVER_PORT=8443    # code-server browser IDE
JUPYTER_PORT=8888       # Jupyter / JupyterLab
MLFLOW_PORT=5555        # MLflow UI

# ── Device Toggle ────────────────────────────────────────────────────────────
# Set to "gpu" to enable NVIDIA GPU passthrough (requires NVIDIA Container
# Toolkit installed on the host). Default is "cpu" (no GPU resources reserved).
DEVICE=cpu

# ── Frontend API Configuration (student-side, NOT baked into image) ──────────
# Set this to the base URL of the API your frontend talks to.
# Vite-based projects read this at build/dev time via import.meta.env.
VITE_API_BASE_URL=https://astryx.atmeta.com/

# ── Pi AI Assistant — Free-Tier Routing ──────────────────────────────────────
# When PI_FREE_ONLY=1, Pi is locked to free/zero-cost providers only.
# See the deployment guide for pi-free free/all toggle commands.
PI_FREE_ONLY=1

# ── Pi Provider API Keys (optional, commented out by default) ────────────────
# Some Pi free-tier providers accept key-based auth instead of browser OAuth.
# Uncomment and fill in the ones you have.  Keys are written to ~/.pi/free.json
# or exported as environment variables before the Pi CLI reads them.
# KILO_API_KEY=
# CLINE_API_KEY=
# OPENROUTER_API_KEY=
