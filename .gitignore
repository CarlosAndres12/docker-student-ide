# ── OpenSpec / agent workflow artifacts (dev-only, not needed by students) ──
openspec/
.agent/
.pi/
.atl/
.opencode/

# ── Windows VM test harness ──
# Replaced by dockur/windows (Docker). Container volumes live outside the
# repo; keep the lesson: multi-GB volatile assets must never enter the repo
# or OpenCode's snapshot feature tracks them as git objects.
# (Previous harness: test/windows-vm/* — removed 2026-08-12)

# Pester results mounted locally (the Docker runner keeps them in a volume)
tests/windows/results/

# Student workspace — contains student projects and generated content
# We ignore everything inside by default but allow tracking a starter
# package.json and .gitkeep via ! exceptions.
student_workspace/*
!student_workspace/.gitkeep
!student_workspace/package.json

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg
.venv/
venv/

# Node / npm build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
dist/

# IDE / OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
